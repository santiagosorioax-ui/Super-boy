rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 0. Connection Test Document
    match /test/{docId} {
      allow read: if true;
    }

    // 1. Private User Game State and Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 100;
      allow update: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }

    // 2. Public Leaderboard High Scores
    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 100;
      allow update: if isOwner(userId) && isValidId(userId)
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isOwner(userId);
    }
  }
}
